# =============================================================
#  ZALO TICKET BOT - CẤU HÌNH MÔI TRƯỜNG
#  Copy file này thành .env rồi điền các giá trị thật vào:
#    cp .env.example .env
# =============================================================

# --- ZALO OA ---
# Token xác thực Bot (lấy từ trang Zalo for Developers)
BOT_TOKEN=

# Chuỗi bí mật dùng để xác minh Webhook từ Zalo
WEBHOOK_SECRET_TOKEN=

# Tên Bot (phải khớp với tên hiển thị trong nhóm Zalo để Bot nhận được @mention)
BOT_NAME=@Bot Meyschool - IT

# --- AI (GROQ) ---
# API Key Groq - lấy tại https://console.groq.com/keys
AI_API_KEY=

# --- SERVER ---
# Cổng chạy ứng dụng
PORT=3000

# URL công khai của server (dùng cho link callback, ví dụ: https://api.minhhan.net)
PUBLIC_URL=https://your-domain.com

# --- BẢO MẬT ---
# Chuỗi bí mật để ký JWT (đặt ngẫu nhiên dài >= 32 ký tự)
JWT_SECRET=change_this_to_a_long_random_secret_string
